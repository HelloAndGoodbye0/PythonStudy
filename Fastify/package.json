{
  "name": "fastify-ts-example",
  "version": "1.0.0",
  "description": "A simple Fastify TypeScript example",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --exec ts-node src/server.ts",
    "dev:watch": "nodemon --watch src --exec ts-node src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@fastify/autoload": "^5.7.0",
    "@prisma/adapter-better-sqlite3": "^7.4.0",
    "@prisma/client": "^7.4.0",
    "dotenv": "^17.2.4",
    "fastify": "^4.29.1",
    "fastify-plugin": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.33",
    "nodemon": "^3.0.0",
    "prisma": "^7.4.0",
    "ts-node": "^10.9.0",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
